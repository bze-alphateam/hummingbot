#########################################################
###  Pool-anchored market making: testnet TUSDC/BZE  ###
#########################################################
# Copy to conf/controllers/beezee_pool_anchored_pmm_testnet.yml. Copy
# conf/scripts/beezee_pool_anchored_pmm_runner_testnet.yml.example (it lists this file) to
# conf/scripts/beezee_pool_anchored_pmm_runner_testnet.yml, then
#   start --v2 beezee_pool_anchored_pmm_runner_testnet.yml
# Quotes TUSDC on the order book around the pool price, never closer than the pool fee + min_spread_over_pool_fee_pct.
# How it works and what it costs: README_BZE.md, sections "Pool-anchored market making" and "AMM run guide".
# Network: bzetestnet-3. In `connect beezee` pick network `testnet` with the endpoints of README_BZE.md "Testnet run"
# and gas price 0.01 ubze (the testnet minimum; 0.001 is refused).

id: beezee_pool_anchored_pmm_testnet
controller_name: beezee_pool_anchored_pmm
controller_type: market_making
connector_name: beezee

# TUSDC quoted in BZE: market factory/bze1z3mkcr2jz424w6m49frgjmy9uhlrx69phqwg3l/testusd / ubze, pool
# factory/bze1z3mkcr2jz424w6m49frgjmy9uhlrx69phqwg3l/testusd_ubze (pool fee 0.2%). The market has to be created once
# before the first run (README_BZE.md, "AMM run guide", testnet pair).
trading_pair: "TUSDC-BZE"

# Budget for all levels together, in BZE: 100 BZE of bids and TUSDC worth 100 BZE of asks (about 77 TUSDC), plus
# BZE for the fees. Each order pays the 0.001 BZE maker fee and its tx gas.
total_amount_quote: 200

# 1% and 2% from the pool price, 50 BZE per level. The spread floor is 0.2% pool fee + 0.1% = 0.3%.
buy_spreads: "0.01,0.02"
sell_spreads: "0.01,0.02"
buy_amounts_pct: "50,50"
sell_amounts_pct: "50,50"

min_spread_over_pool_fee_pct: 0.1
requote_threshold_pct: 0.2
executor_refresh_time: 300
cooldown_time: 15

# The BeeZee book takes limit orders only: no stop loss, time limit or position rebalance.
take_profit: 0.02
take_profit_order_type: LIMIT
stop_loss:
time_limit:
skip_rebalance: true
leverage: 1

# Hedge mode, off here; the testnet checklist turns it on. A fill of a 50 BZE level is hedged when its distance from
# the pool price covers 0.2% pool fee + (0.1 BZE taker fee + 0.005 BZE gas) / 50 BZE = 0.21% + 0.1% margin, i.e. about
# 0.51%: the 1% level qualifies, a level at the 0.3% floor would not.
hedge_fills_on_pool: false
hedge_slippage_pct: 0.5
min_hedge_profit_pct: 0.1
estimated_gas_bze: 0.005
