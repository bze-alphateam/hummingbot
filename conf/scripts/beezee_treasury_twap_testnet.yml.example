#########################################################
###  Treasury TWAP: testnet TUSDC/BZE                 ###
#########################################################
# Copy to conf/scripts/beezee_treasury_twap_testnet.yml, then
#   start --v2 beezee_treasury_twap_testnet.yml
# Sells 60 TUSDC for BZE over 30 minutes, one slice every 5 minutes, each slice sent whole to the cheaper venue (the
# pool or the book).
# How it works and what it costs: README_BZE.md, sections "Treasury TWAP" and "AMM run guide".
# Network: bzetestnet-3. In `connect beezee` pick network `testnet` with the endpoints of README_BZE.md "Testnet run"
# and gas price 0.01 ubze (the testnet minimum; 0.001 is refused).

script_file_name: beezee_treasury_twap.py
controllers_config: []

exchange: beezee

# TUSDC quoted in BZE: market factory/…/testusd / ubze, pool factory/bze1z3mkcr2jz424w6m49frgjmy9uhlrx69phqwg3l/
# testusd_ubze (pool fee 0.2%). The market has to exist (README_BZE.md, "AMM run guide", testnet pair).
trading_pair: "TUSDC-BZE"

side: sell
total_amount: 60

# 0.5 h / 300 s = 6 slices of 10 TUSDC (about 13 BZE each).
duration_hours: 0.5
slice_interval_seconds: 300

max_impact_pct: 0.5
limit_price:
venue: best
slippage_pct: 0.5

# Balances the script never spends: BZE (also covers the fees), then TUSDC.
keep_quote_reserve: 20
keep_base_reserve: 0

catch_up: true

# Cost of one slice: 0.1 BZE taker fee + gas (about 200,000 gas x 0.01 ubze = 0.002 BZE), plus the pool fee (0.2%)
# on a pool slice. About 0.65 BZE for the whole run.
estimated_gas_bze: 0.005
