#########################################################
###  Treasury TWAP: BZE/USDC.inj                      ###
#########################################################
# Copy to conf/scripts/beezee_treasury_twap.yml, set the side, the amount and the period, then
#   start --v2 beezee_treasury_twap.yml
# Buys back (side: buy) or sells down (side: sell) total_amount BZE against USDC.inj over duration_hours, one slice
# every slice_interval_seconds, each slice capped by its own price impact and sent whole to the cheaper venue.
# How it works and what it costs: README_BZE.md, sections "Treasury TWAP" and "AMM run guide".
# Network: beezee-1. In `connect beezee` pick network `mainnet` (gas price 0.01 ubze).

script_file_name: beezee_treasury_twap.py
controllers_config: []

exchange: beezee

# BZE quoted in USDC bridged from Injective (USDC.inj): market ubze/ibc/81DA528F…, pool ibc/81DA528F…_ubze
# (pool fee 0.1%). USDC.inj counts in USDC (6 decimals, from the asset list): limit_price and keep_quote_reserve
# below are in USDC.
# Pair name: USDC.inj is labelled USDC.INJ, as on dex.getbze.com (README_BZE.md, "Denom labels").
trading_pair: "BZE-USDC.INJ"

# "buy" buys BZE back with USDC.inj, "sell" sells BZE for USDC.inj.
side: buy

# The BZE amount over the whole run. Placeholder.
total_amount: 100000

# 168 h / 600 s = 1,008 slices of about 99 BZE.
duration_hours: 168
slice_interval_seconds: 600

max_impact_pct: 0.5

# Never buy above this price, in USDC per BZE. Placeholder; empty = no limit.
limit_price: 0.00045

venue: best
slippage_pct: 0.5

# Balances the script never spends: USDC.inj, then BZE. A buy spends USDC.inj but pays its fees in BZE,
# so keep about 110 BZE free for this run's fees (below).
keep_quote_reserve: 0
keep_base_reserve: 0

catch_up: true

# Cost of one slice: 0.1 BZE taker fee + gas (about 200,000 gas x 0.01 ubze = 0.002 BZE), plus the pool fee (0.1%)
# on a pool slice. 1,008 slices pay about 1,008 x 0.105 = 106 BZE of fixed fees.
estimated_gas_bze: 0.005
